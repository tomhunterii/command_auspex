{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities: SQL catalogue (read-only bundled) + user.db, dialogs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute",
    "sql:allow-close",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
